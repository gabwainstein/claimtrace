  "nodes": [
    {
      "id": "question:within-recording-decoding",
      "type": "question",
      "status": "current",
      "value": "Can a fixed sensor-space pipeline distinguish imagined movement of both hands from both feet across S001 runs 06, 10, and 14?"
    },
    {
      "id": "hyp:discriminative-pattern",
      "type": "hypothesis",
      "status": "current",
      "value": "These selected S001 motor-imagery recordings contain a run-generalizable sensor-space pattern that differs between both-hands and both-feet labels."
    },
    {
      "id": "pred:above-null",
      "type": "prediction",
      "status": "current",
      "backbone": {
        "dataset_version": "PhysioNet EEGMMIDB 1.0.0",
        "analysis_plan": "s001-mi-logo-csp-lda-v1"
      },
      "value": "For S001 runs 06, 10, and 14, the fixed final 7-30 Hz CSP plus LDA pipeline's mean leave-one-run-out balanced accuracy will exceed the higher-method 95th percentile of 199 label permutations constrained within run."
    },
    {
      "id": "claim:above-null",
      "type": "claim",
      "status": "current",
      "backbone": {
        "dataset_version": "PhysioNet EEGMMIDB 1.0.0",
        "analysis_plan": "s001-mi-logo-csp-lda-v1"
      },
      "value": "For participant S001 in PhysioNet EEGMMIDB v1.0.0 runs 06, 10, and 14, the fixed final 7-30 Hz four-component regularized CSP plus shrinkage-LDA pipeline achieved mean leave-one-run-out balanced accuracy 0.842262, exceeding the higher-method 95th percentile 0.657738 of 199 label permutations constrained within run.",
      "logic": {
        "vocabulary_id": "eegbci:vocabulary",
        "rule_pack_id": "eegbci:decoding-rules",
        "target": {
          "predicate": "eegbci:exceeds_run_constrained_null",
          "polarity": "positive",
          "arguments": {
            "study": {
              "type": "eegbci:study",
              "value": "eegbci-s001-r06-r10-r14-v1.0.0",
              "unit": null
            }
          }
        }
      },
      "logic_evidence_plan": {
        "schema_version": "claimtrace.symbolic-evidence-plan/1",
        "required_bindings": [
          {
            "result_id": "art:decoding",
            "binding_id": "eegbci:decoding-summary"
          }
        ]
      }
    },
    {
      "id": "ref:eegbci-dataset",
      "type": "reference",
      "status": "current",
      "value": "Schalk G. EEG Motor Movement/Imagery Dataset, version 1.0.0. PhysioNet. DOI:10.13026/C28G6P"
    },
