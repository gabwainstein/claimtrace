          "arguments": {
            "study": {"var": "study"},
            "pooled": {"var": "pooled"},
            "adelie": {"var": "adelie"},
            "chinstrap": {"var": "chinstrap"},
            "gentoo": {"var": "gentoo"}
          }
        }
      ],
      "where": [
        {"op": "lte", "left": {"var": "gentoo"}, "right": {"const": {"type": "ct:decimal", "value": "0", "unit": "penguin:mm-per-mm"}}}
      ],
      "then": {
        "predicate": "penguin:species_conditioned_sign_reversal",
        "polarity": "negative",
        "arguments": {"study": {"var": "study"}}
      }
    }
  ]
}
