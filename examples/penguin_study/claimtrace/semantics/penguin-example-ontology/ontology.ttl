@prefix ex: <urn:claimtrace:example:penguin-study:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:ontology a owl:Ontology .

ex:BillLengthMeasurement a owl:Class ;
    rdfs:label "bill length measurement"@en ;
    rdfs:comment "A bill length measurement defined for the Claimtrace Palmer Penguins example."@en .
