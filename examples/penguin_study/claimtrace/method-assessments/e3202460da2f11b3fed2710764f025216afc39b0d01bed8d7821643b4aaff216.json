              "steps": [
                {
                  "id": "select_complete_bills",
                  "required": true,
                  "statement": "Read the curated Palmer Penguins CSV and retain records whose bill length and bill depth are both present, converting those measurements to floats."
                },
                {
                  "id": "group_by_species",
                  "required": true,
                  "statement": "Partition complete records by the declared Adelie, Chinstrap, and Gentoo species and fail if that exact species set is not observed."
                },
                {
                  "id": "fit_descriptive_ols",
                  "required": true,
                  "statement": "For pooled records and each declared species, compute the ordinary least-squares slope and intercept for bill depth on bill length, Pearson correlation, and R-squared, and also compute the common within-species slope."
                },
                {
                  "id": "export_slope_profile",
                  "required": true,
                  "statement": "Classify whether the pooled slope is negative while every species-specific slope is positive, then write the rounded estimates, sample counts, pattern, and interpretation boundary to results/slopes.json."
                }
              ]
            },
